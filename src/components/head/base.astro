---
import { Font, getImage } from 'astro:assets';
import { siteAuthor, siteTitle, socials } from '@utils/globals';
import FavIcon from '@assets/favicon.ico';
import PostHog from '@components/head/posthog.astro';
import markdownPath from '@utils/markdownPath';
import {
  SOCIAL_IMAGE,
  getSocialImage,
  type SocialImage,
} from '@utils/socialImage';

interface Props {
  title: string;
  description: string;
  socialImage?: SocialImage;
}

const { title, description, socialImage = getSocialImage() } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const markdownURL = markdownPath(Astro.url.pathname);
const ogImageURL = new URL(socialImage.path, Astro.site);
const favIcon = await getImage({
  src: FavIcon,
  width: 48,
  height: 48,
  format: 'ico',
});
---

<meta charset="utf-8" />
<link rel="icon" type="image/x-icon" href={favIcon.src} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="light dark" />
<Font
  cssVariable="--font-serif"
  preload={[{ subset: 'latin', style: 'normal', weight: '400' }]}
/>
<Font
  cssVariable="--font-sans"
  preload={[
    { subset: 'latin', style: 'normal', weight: '400' },
    { subset: 'latin', style: 'normal', weight: '700' },
  ]}
/>
<Font cssVariable="--font-mono" />
<meta name="title" property="og:title" content={title} />
<meta
  name="description"
  content={description}
  data-pagefind-meta="description[content]"
/>
<meta property="og:description" content={description} />
<meta property="og:image:alt" content={socialImage.alt} />
<meta name="twitter:image:alt" content={socialImage.alt} />
<meta name="author" content={siteAuthor.name} />
<meta name="generator" content={Astro.generator} />
<meta name="fediverse:creator" content={socials.activitypub.username} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={socials.x.username} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta
  name="twitter:image"
  content={ogImageURL}
  data-pagefind-default-meta="image[content]"
/>
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:type" content={SOCIAL_IMAGE.contentType} />
<meta property="og:image:width" content={String(SOCIAL_IMAGE.width)} />
<meta property="og:image:height" content={String(SOCIAL_IMAGE.height)} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteTitle} />
<meta name="robots" content="max-image-preview:large" />
<title>{`${title} | ${siteTitle}`}</title>
<link rel="canonical" href={canonicalURL} />
{
  markdownURL && (
    <link
      rel="alternate"
      type="text/markdown"
      title={`View as Markdown: ${title}`}
      href={new URL(markdownURL, Astro.site)}
    />
  )
}
<link rel="sitemap" href={new URL('sitemap-index.xml', Astro.site)} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteTitle}
  href={new URL('feed.xml', Astro.site)}
/>
<PostHog />
