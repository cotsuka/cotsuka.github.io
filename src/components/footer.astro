---
import { siteAuthor, socials } from '@utils/globals';

const currentYear = new Date().getFullYear();
---

<footer>
  <address>
    <menu class="inline-menu">
      {
        Object.entries(socials).map(([, social]) => (
          <li>
            <a href={social.url} rel="me">
              {social.title}
            </a>
          </li>
        ))
      }
    </menu>
  </address>
  <p>
    &copy; {currentYear}{' '}
    {siteAuthor.name}.{' '}
    <a href="/feed.xml" aria-label="RSS feed">
      <svg
        class="rss"
        viewBox="0 0 24 24"
        width="1em"
        height="1em"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z"
        ></path>
      </svg>
    </a>
  </p>
  <p>
    All views my own. Not financial advice. Links, citations, and other
    references are not endorsements. Content is licensed under{' '}
    <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
  </p>
</footer>

<style>
  footer {
    text-align: center;
    border-block-start: 1px solid var(--color-text);
    margin-block-start: 1rem;
    padding-block-start: 1rem;
  }
  footer p {
    text-align: center;
  }
  address {
    font-family: var(--font-sans);
  }
  li {
    padding-inline-end: 0.5rem;
  }
  .rss {
    display: inline-block;
    vertical-align: middle;
  }
</style>
