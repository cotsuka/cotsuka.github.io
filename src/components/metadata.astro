---
import Disclosure from '@components/ui/disclosure.astro';
import type { SiteCollectionEntry } from '@utils/globals';
import type getEntryPresentation from '@utils/getEntryPresentation';
import { getPlatformLabel } from '@utils/platforms';

interface Props {
  entry: SiteCollectionEntry;
  presentation: ReturnType<typeof getEntryPresentation>;
}

const { entry, presentation } = Astro.props;
const { data } = entry;
const {
  publicationName,
  publicationLabel,
  publishedDate,
  updatedDate,
  publishedAt,
  updatedAt,
  posse,
} = presentation;
---

<div class="metadata-section">
  <Disclosure summary="Metadata" data-pagefind-ignore>
    <dl class="metadata">
      {
        publicationName && (
          <div
            data-pagefind-meta={`publication:${publicationName}`}
            data-pagefind-filter={`publication:${publicationName}`}
          >
            <dt>Publication</dt>
            <dd>{publicationLabel}</dd>
          </div>
        )
      }
      <div>
        <dt>Published</dt>
        <dd>
          <time datetime={publishedAt} data-pagefind-sort="publishedAt">
            {publishedDate}
          </time>
        </dd>
      </div>
      <div>
        <dt>Last updated</dt>
        <dd><time datetime={updatedAt}>{updatedDate}</time></dd>
      </div>
      <div
        data-pagefind-meta={`format:${data.format}`}
        data-pagefind-filter={`format:${data.format}`}
      >
        <dt>Format</dt>
        <dd>{data.format}</dd>
      </div>
      {
        data.tags.length > 0 && (
          <div>
            <dt>Tags</dt>
            <dd>{data.tags.join(', ')}</dd>
          </div>
        )
      }
      {
        Object.keys(posse).length > 0 && (
          <div>
            <dt>POSSE</dt>
            <dd class="platforms">
              {Object.entries(posse).map(([name, url]) => (
                <a href={url}>{getPlatformLabel(name)}</a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>
  </Disclosure>
</div>

<style>
  .metadata-section {
    font-size: 0.8rem;
  }

  .metadata {
    margin-block: 0.5rem 0;
  }

  .metadata > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
  }

  .metadata > div + div {
    margin-block-start: 0.35rem;
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
    padding: 0;
    overflow-wrap: anywhere;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  @media (max-width: 30rem) {
    .metadata > div {
      grid-template-columns: minmax(0, 1fr);
    }

    .metadata > div + div {
      margin-block-start: 0.65rem;
    }
  }
</style>
