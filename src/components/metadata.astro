---
import type { SiteCollectionEntry } from '@utils/globals';
import type getEntryPresentation from '@utils/getEntryPresentation';
import { getPlatformLabel } from '@utils/platforms';

interface Props {
  entry: SiteCollectionEntry;
  presentation: ReturnType<typeof getEntryPresentation>;
}

const { entry, presentation } = Astro.props;
const { data } = entry;
const {
  publicationName,
  publicationLabel,
  ratingText,
  publishedDate,
  updatedDate,
  publishedAt,
  updatedAt,
  posse,
} = presentation;
---

<details data-pagefind-ignore>
  <summary>Metadata</summary>
  <ul>
    {data.description && <li>Description: {data.description}</li>}
    {
      publicationName && (
        <li
          data-pagefind-meta={`publication:${publicationName}`}
          data-pagefind-filter={`publication:${publicationName}`}
        >
          Publication: {publicationLabel}
        </li>
      )
    }
    {ratingText && <li>Rating: {ratingText}</li>}
    <li>
      Published: <time datetime={publishedAt} data-pagefind-sort="publishedAt">
        {publishedDate}
      </time>
    </li>
    <li>
      Last Updated: <time datetime={updatedAt}>{updatedDate}</time>
    </li>
    <li
      data-pagefind-meta={`format:${data.format}`}
      data-pagefind-filter={`format:${data.format}`}
    >
      Format: {data.format}
    </li>
    {data.tags.length > 0 && <li>Tags: {data.tags.join(', ')}</li>}
    {
      Object.keys(posse).length > 0 && (
        <li>
          POSSE:{' '}
          {Object.entries(posse).map(([name, url]) => (
            <Fragment>
              <a href={url}>{getPlatformLabel(name)}</a>&nbsp;
            </Fragment>
          ))}
        </li>
      )
    }
  </ul>
</details>

<style>
  details {
    margin-block-end: 1rem;
    font-size: 0.8rem;
    &::details-content {
      opacity: 0;
    }
    &[open]::details-content {
      opacity: 1;
      transition: all 0.4s linear;
    }
  }
  summary:hover {
    cursor: pointer;
  }
</style>
