---
import { getCollection } from 'astro:content';
import type { SiteCollection } from '@utils/globals';
import ContentListHeading from '@components/ui/contentlistheading.astro';
import sortByDate from '@utils/sortByDate';
import getEntryPresentation from '@utils/getEntryPresentation';

interface Props {
  collection: SiteCollection;
  limit?: number;
}

const { collection, limit } = Astro.props;
const entries = await getCollection(collection);
const sorted = sortByDate(entries);
const displayedEntries =
  typeof limit === 'number' ? sorted.slice(0, limit) : sorted;
---

<dl>
  {
    displayedEntries.map((entry) => (
      <>
        <dt>
          <ContentListHeading entry={entry} />
        </dt>
        <dd>{getEntryPresentation(entry).listSubtitle}</dd>
      </>
    ))
  }
</dl>

<style>
  dd:not(:last-child) {
    padding-block-end: 0.75rem;
    border-block-end: 1px dotted var(--color-border);
  }
</style>
