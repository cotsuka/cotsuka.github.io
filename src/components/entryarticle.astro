---
import Base from '@layouts/base.astro';
import HeadArticle from '@components/head/article.astro';
import Metadata from '@components/metadata.astro';
import EntryContent from '@components/entrycontent.astro';
import getEntryPresentation from '@utils/getEntryPresentation';
import { getSocialImage } from '@utils/socialImage';
import type { SiteCollectionEntry } from '@utils/globals';

interface Props {
  entry: SiteCollectionEntry;
}

const { entry } = Astro.props;
const presentation = getEntryPresentation(entry);
---

<Base
  title={entry.data.title}
  description={presentation.metaDescription}
  socialImage={getSocialImage(entry, presentation)}
>
  <HeadArticle
    slot="post-head"
    publishedAt={presentation.publishedAt}
    updatedAt={presentation.updatedAt}
    tags={entry.data.tags}
  />
  <article data-pagefind-body>
    <h2
      data-pagefind-meta="title"
      data-pagefind-filter={`collection:${entry.collection}`}
    >
      {entry.data.title}
    </h2>
    <Metadata entry={entry} presentation={presentation} />
    <EntryContent entry={entry} />
  </article>
</Base>
