---
import '@styles/reset.css';
import '@styles/style.css';
import '@styles/code.css';
import HeadBase from '@components/head/base.astro';
import type { SocialImage } from '@utils/socialImage';
import Navigation from '@components/navigation.astro';
import Footer from '@components/footer.astro';
import markdownPath from '@utils/markdownPath';

interface Props {
  title: string;
  description: string;
  socialImage?: SocialImage;
}

const { title, description, socialImage } = Astro.props;
const markdownURL = markdownPath(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <HeadBase
      title={title}
      description={description}
      socialImage={socialImage}
    />
    <slot name="post-head">
      <meta property="og:type" content="website" />
    </slot>
  </head>
  <body>
    <Navigation />
    <main>
      <slot />
    </main>
    {
      markdownURL && (
        <p data-pagefind-ignore>
          <a href={markdownURL}>View as Markdown</a>
        </p>
      )
    }
    <Footer />
  </body>
</html>
