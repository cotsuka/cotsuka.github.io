---
import Base from '@layouts/base.astro';
import ContentList from '@components/ui/contentlist.astro';
import { COLLECTIONS, type SiteCollection } from '@utils/collections';

interface Props {
  collection: SiteCollection;
}

const { collection } = Astro.props;
const { label, description } = COLLECTIONS[collection];
---

<Base title={label} description={description}>
  <h2>{label}</h2>
  <slot name="before-list" />
  <slot>
    <ContentList collection={collection} />
  </slot>
</Base>
